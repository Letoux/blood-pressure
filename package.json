{
  "name": "blood-pressure",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:node && cp -r .next/static .next/standalone/.next/",
    "build:node": "esbuild src/scripts/migrate.ts src/worker/main.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --out-extension:.js=.mjs --external:pg-native --banner:js=\"import { createRequire } from \\\"node:module\\\"; const require = createRequire(import.meta.url);\"",
    "start": "node .next/standalone/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "worker": "tsx src/worker/main.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:backup": "sh docker/backup.test.sh",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@orpc/client": "^1.16.1",
    "@orpc/server": "^1.16.1",
    "@orpc/tanstack-query": "^1.16.1",
    "@tanstack/react-query": "^5.105.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

# Copier ce fichier en `.env` et remplacer chaque valeur. Ne jamais committer `.env`.

# URL publique de l'application (celle du reverse proxy), sans slash final.
APP_URL=https://tension.example.org

# Port exposé sur l'hôte par le conteneur `app` (cible du reverse proxy).
APP_PORT=3000

# Base de données Postgres (service `db`). L'URL de connexion est construite par le compose.
# Mot de passe : caractères sûrs dans une URL uniquement, par exemple `openssl rand -hex 24`.
POSTGRES_USER=bloodpressure
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-long
POSTGRES_DB=bloodpressure

# Compte administrateur (ADR-0004) : gère les comptes, n'a jamais accès aux mesures.
# Mot de passe de 10 caractères minimum.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-long

# L'inscription libre (ADR-0004) n'est pas réglée ici : elle est fermée par défaut et l'admin
# l'ouvre ou la ferme depuis la page d'administration (réglage enregistré en base).

# Clé de signature des cookies de session, 32 caractères minimum : `openssl rand -hex 32`.
BETTER_AUTH_SECRET=remplacer-par-une-cle-aleatoire-de-32-caracteres-minimum

# Sauvegardes (service `backup`) : un dump `pg_dump` par jour dans BACKUP_DIR, sur l'hôte.
# Dossier de l'hôte qui reçoit les dumps (créé au besoin). Pensez à le copier ailleurs.
BACKUP_DIR=./backups
# Heure du dump quotidien, au format HH:MM, dans le fuseau BACKUP_TZ.
BACKUP_TIME=03:00
BACKUP_TZ=Europe/Paris
# Nombre de jours de dumps conservés ; les plus anciens sont supprimés après chaque dump.
BACKUP_RETENTION_DAYS=14
